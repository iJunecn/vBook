---
import { eq } from 'drizzle-orm';
import Layout from '../../layouts/Layout.astro';
import BuyButton from '../../components/vue/BuyButton.vue';
import { db } from '../../lib/db';
import { books, listings, users } from '../../lib/schema';
import { CAMPUS_LABELS } from '../../components/vue/types';

export const prerender = false;

const { id } = Astro.params;

const [book] = await db
  .select({
    id: books.id,
    title: books.title,
    author: books.author,
    publisher: books.publisher,
    isbn: books.isbn,
    edition: books.edition,
    price: books.price,
    status: books.status,
    createdAt: books.createdAt,
    sellerId: listings.sellerId,
    sellerNickname: users.nickname,
    sellerUsername: users.username,
    sellerCampus: users.campus,
  })
  .from(books)
  .innerJoin(listings, eq(books.listingId, listings.id))
  .innerJoin(users, eq(listings.sellerId, users.id))
  .where(eq(books.id, id!));

if (!book) return Astro.redirect('/404');

const user = Astro.locals.user;
const isOwn = !!user && user.id === book.sellerId;
const sold = book.status !== 'available';

const fields = [
  { label: '作者', value: book.author },
  { label: '出版社', value: book.publisher },
  { label: 'ISBN', value: book.isbn },
  { label: '版次', value: book.edition },
];
---

<Layout title={book.title}>
  <a href="/" class="mb-4 inline-block text-sm text-slate-500 hover:text-brand-700">← 返回浏览</a>

  <div class="grid gap-8 md:grid-cols-3">
    <div class="md:col-span-2 space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h1 class="text-2xl font-bold text-slate-800">{book.title}</h1>
        <dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            fields.map((f) => (
              <div class="flex justify-between border-b border-slate-100 py-1.5 text-sm">
                <dt class="text-slate-400">{f.label}</dt>
                <dd class="font-medium text-slate-700">{f.value || '—'}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <aside class="space-y-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm text-slate-400">售价</p>
        <p class="text-3xl font-bold text-rose-600">¥{book.price}</p>

        <div class="my-5 h-px bg-slate-100"></div>

        <p class="text-sm text-slate-400">卖家</p>
        <p class="font-medium text-slate-700">
          {book.sellerNickname || book.sellerUsername}
        </p>
        {
          book.sellerCampus && (
            <span class="mt-1 inline-block rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">
              {CAMPUS_LABELS[book.sellerCampus] || book.sellerCampus}
            </span>
          )
        }

        <div class="mt-6">
          <BuyButton
            client:load
            bookId={book.id}
            loggedIn={!!user}
            sold={sold}
            isOwn={isOwn}
          />
        </div>
      </div>
    </aside>
  </div>
</Layout>
