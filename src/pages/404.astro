---
import Layout from '../layouts/Layout.astro';
---

<Layout title="未找到">
  <div class="py-24 text-center">
    <p class="text-6xl">🐚</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-800">页面未找到</h1>
    <p class="mt-2 text-slate-500">你访问的内容可能已被删除或不存在</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white hover:bg-brand-700"
    >
      返回首页
    </a>
  </div>
</Layout>
