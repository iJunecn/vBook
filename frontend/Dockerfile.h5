# H5 镜像：编译 uni-app 产物为静态文件并由 nginx 提供服务
# 直接监听 6628 而非 80，省去 root 权限和端口冲突问题，对外 6628:6628。
# 用法（无需手动操作，docker compose up -d --build 会自动跑）：
#   docker compose up -d --build
#   → H5 用户访问：   http://localhost:6628
#   → 后端 API：      http://localhost:6627
#
# 关键点：构建期不再注入 VITE_API_HOST，让 API_BASE 走相对路径 '/api/v1'。
# 这样浏览器只看到 nginx(6628) 这一个源，跨域问题彻底消失，
# 局域网/公网用户从任意 IP 访问 6628 都能正常调 API。

# ---- builder ----
FROM oven/bun:1-alpine AS builder
WORKDIR /build

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
# 注意：VITE_API_HOST 在这里有意不传，使 config.js 里取到空串 → API_BASE = '/api/v1'
# 如需在镜像里硬编码一个固定后端地址，临时取消下行注释即可（不推荐）
# ARG VITE_API_HOST=http://localhost:6627
# ENV VITE_API_HOST=$VITE_API_HOST
RUN bun run build:h5

# ---- runtime ----
FROM nginx:1.27-alpine
# 直接用本仓库的 nginx.conf，里面 listen 6628；容器内 6628 → 主机 6628
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist/build/h5 /usr/share/nginx/html

EXPOSE 6628

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:6628/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
