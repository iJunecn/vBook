# ===== 贝壳易书 - 环境变量（示例模板）=====
# 复制为 .env 即可生效；本文件示例，不会被 git 追踪。

# ---- 应用基础 ----
APP_NAME=贝壳易书
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 后端服务监听端口（同时被 Dockerfile / docker-compose / uvicorn 引用）----
BACKEND_PORT=6627

# ---- 数据库 ----
# 默认使用容器内路径，docker-compose 已自动注入；本机开发可改为 sqlite:///./data/vbook.db
DATABASE_URL=sqlite:////app/data/vbook.db

# ---- CORS ----
# 允许跨域来源：H5 默认 6628、uni-app 编译期 5173、小程序真机调试用局域网 IP
CORS_ORIGINS=http://localhost:6628,http://127.0.0.1:6628,http://localhost:5173,http://127.0.0.1:5173

# ---- 文件 ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=20971520
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# ---- 微信小程序登录 ----
# 在微信公众平台（mp.weixin.qq.com）注册小程序后获取
WECHAT_APPID=
WECHAT_SECRET=

# ====== agnes 大模型（OpenAI 兼容） ======
AGNES_API_KEY=
AGNES_BASE_URL=https://agnes-ai.com
AGNES_MODEL=agnes-2.0-flash
AGNES_TIMEOUT=60

# ====== PaddleOCR (AIStudio) ======
PADDLE_OCR_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_OCR_TOKEN=
PADDLE_OCR_MODEL=PP-OCRv6
PADDLE_OCR_TIMEOUT=60
PADDLE_OCR_POLL_INTERVAL=1.5
PADDLE_OCR_MAX_POLLS=40
